{
  "name": "giftbot",
  "version": "0.1.0",
  "private": true,
  "description": "GiftBot — AI gift recommendations over WhatsApp",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx scripts/demo.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed-sample": "tsx scripts/db-seed-sample.ts",
    "catalog:import": "tsx scripts/catalog-import.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "csv-parse": "7.0.2",
    "fast-xml-parser": "5.11.1",
    "pg": "8.23.1",
    "zod": "4.6.5"
  }
}
