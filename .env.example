# Copy this file to .env and fill in real values locally.
# Never commit .env — it is ignored by git.

# HTTP port for the backend server
PORT=3000

# development | test | production
NODE_ENV=development

# Postgres connection string (local Postgres, or Supabase's direct/pooler connection string).
# Contains a password — keep it only in .env, never in code or chat.
# Example format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
