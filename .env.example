# Copy this file to .env and fill in real values locally.
# Never commit .env — it is ignored by git.

# HTTP port for the backend server
PORT=3000

# development | test | production
NODE_ENV=development

# Postgres connection string (local Postgres, or Supabase's direct/pooler connection string).
# Contains a password — keep it only in .env, never in code or chat.
# Example format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# --- WhatsApp Cloud API (all four required together; leave empty to disable) ---
# A random string YOU choose (16+ chars); enter the same value in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Meta app → App settings → Basic → App secret. Secret.
WHATSAPP_APP_SECRET=
# Meta app → WhatsApp → API setup → access token. Secret.
WHATSAPP_ACCESS_TOKEN=
# Meta app → WhatsApp → API setup → Phone number ID (digits).
WHATSAPP_PHONE_NUMBER_ID=
# Optional. Defaults to v26.0.
WHATSAPP_GRAPH_API_VERSION=

# Show ⚠️ sample products to users. Test environments only (refused in production).
ALLOW_SAMPLE_PRODUCTS=false
